# Copier ce fichier en `.env.local` et définir une vraie valeur.
# `.env.local` n'est jamais committé (cf. .gitignore).

# Base de données Postgres (OBLIGATOIRE).
# - En prod : URL « pooled » d'un Postgres managé (Neon / Vercel Postgres).
# - En local : conteneur Docker Postgres (voir README > Développement).
DATABASE_URL=postgres://user:password@host:5432/rituelio

# Mot de passe du compte prof initial (identifiant « prof »).
# Sert à AMORCER la base au tout premier login : à ce moment-là, il est haché
# (scrypt) et enregistré dans la table `prof_users`. Ensuite, change-le plutôt
# via la page /prof/reglages (l'env ne re-sert que si la base est vide).
PROF_MOT_DE_PASSE=

# Code secret exigé pour créer un compte via la page /inscription.
# Sans cette variable, l'inscription est désactivée (toute tentative est refusée).
CLE_INSCRIPTION=

# Jeton d'écriture Vercel Blob, pour la banque d'images du jeu « Image mystère ».
# OBLIGATOIRE en production : le disque d'une fonction serverless est éphémère.
# Sans cette variable (développement local), les images sont écrites dans
# `.data/images/` et servies par /api/images/<id>/fichier.
# À récupérer sur Vercel : Storage > Blob > .env.local, ou `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
